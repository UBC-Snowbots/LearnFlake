# Ubuntu 24.04 LTS Dockerfile for LearnFlake (ROS2 Jazzy + RoboSuite)
# Designed for Windows Docker Desktop
#
# Build:  docker compose -f docker-compose.ubuntu.yml build
# Run:    docker compose -f docker-compose.ubuntu.yml run --rm rover_rl bash
#
# Migrated from Ubuntu 22.04 / ROS2 Humble 2026-10. The ROS install uses the
# ros2-apt-source .deb, the same method as the team CLI (rovercli
# setup_scripts/install-ros2.sh); for a native host install prefer rovercli
# directly (see setup_scripts/README.md).

FROM ubuntu:24.04

# Prevent interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Workspace configuration
ENV ROVERFLAKE_ROOT=/LearnFlake
ENV ROS_DISTRO=jazzy
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV RL_VENV=/opt/rl-venv
ENV PATH=$RL_VENV/bin:$PATH

# Locale setup (required for ROS2)
RUN apt-get update && apt-get install -y \
    locales \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# ============================================================================
# ROS2 Jazzy Installation (Ubuntu 24.04 LTS)
# Uses the ros2-apt-source .deb, matching rovercli/setup_scripts/install-ros2.sh
# ============================================================================
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    gnupg \
    lsb-release \
    && add-apt-repository -y universe \
    && rm -rf /var/lib/apt/lists/*

# Add ROS2 apt repository via the official ros-apt-source release deb
RUN export ROS_APT_SOURCE_VERSION=$(curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | grep -F "tag_name" | awk -F\" '{print $4}') \
    && curl -L -o /tmp/ros2-apt-source.deb "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.$(. /etc/os-release && echo ${UBUNTU_CODENAME:-${VERSION_CODENAME}})_all.deb" \
    && dpkg -i /tmp/ros2-apt-source.deb \
    && rm -f /tmp/ros2-apt-source.deb

# Install ROS2 Jazzy Desktop (full installation)
RUN apt-get update && apt-get install -y \
    ros-jazzy-desktop \
    ros-jazzy-rmw-cyclonedds-cpp \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-argcomplete \
    ros-dev-tools \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# ROS2 Additional Packages
# ============================================================================
RUN apt-get update && apt-get install -y \
    ros-jazzy-urdf \
    ros-jazzy-xacro \
    ros-jazzy-image-transport \
    ros-jazzy-cv-bridge \
    ros-jazzy-rosidl-default-generators \
    ros-jazzy-rosidl-default-runtime \
    ros-jazzy-ament-cmake \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# System Dependencies
# ============================================================================
RUN apt-get update && apt-get install -y \
    # Build essentials
    build-essential \
    cmake \
    git \
    wget \
    curl \
    vim \
    nano \
    # Python
    python3 \
    python3-pip \
    python3-venv \
    python-is-python3 \
    # Graphics/Rendering (MuJoCo EGL support)
    libegl1 \
    libgl1 \
    libgles2 \
    libglvnd0 \
    libglvnd-dev \
    mesa-utils \
    libosmesa6-dev \
    libglfw3-dev \
    # X11 for GUI (optional, works with WSLg)
    libx11-6 \
    libxcursor1 \
    libxrandr2 \
    libxinerama1 \
    libxi6 \
    libxxf86vm1 \
    # Utilities
    sudo \
    tmux \
    btop \
    htop \
    # Development libraries
    libgtkmm-3.0-dev \
    libsfml-dev \
    # Serial communication
    libusb-1.0-0-dev \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Python Dependencies
# Python 3.12 on 24.04 is PEP 668 externally-managed, so the RL stack lives in
# a venv. --system-site-packages keeps rclpy (on PYTHONPATH from ROS) importable.
# Pins track docker/rl_env_freeze.txt (the env that produced M4). This image is
# CPU-only, so torch is the CPU wheel; use the GPU Dockerfile for cu128/Blackwell.
# ============================================================================
RUN python3 -m venv ${RL_VENV} --system-site-packages \
    && ${RL_VENV}/bin/pip install --upgrade pip setuptools wheel \
    && ${RL_VENV}/bin/pip install --no-cache-dir --default-timeout=300 \
       torch torchvision torchaudio \
    && ${RL_VENV}/bin/pip install --no-cache-dir \
       "numpy==1.26.4" "scipy==1.15.3" "numba==0.65.1" \
       "mujoco==3.9.0" "gymnasium==1.3.0" \
       "stable-baselines3>=2.7,<3" "sb3-contrib>=2.7,<3" \
       "dm-control==1.0.41" "h5py==3.16.0" "tqdm>=4.66" \
       "tensorboard==2.20.0" "PyYAML>=6.0" \
       "mink==0.0.5" "qpsolvers==4.12.0" "pynput" "termcolor" \
       "matplotlib" "opencv-python" "Pillow" "pybullet" \
       "pytest>=7.4" "pytest-cov>=4.1" "coverage>=7.10" "ruff>=0.4"

# ============================================================================
# Workspace Setup
# ============================================================================
WORKDIR ${ROVERFLAKE_ROOT}

# Copy project files
COPY . ${ROVERFLAKE_ROOT}

# Initialize rosdep (ignore errors if already initialized)
RUN rosdep init 2>/dev/null || true \
    && rosdep update --rosdistro jazzy

# Install ROS dependencies from package.xml files
RUN . /opt/ros/jazzy/setup.sh \
    && cd ${ROVERFLAKE_ROOT} \
    && rosdep install --from-paths src --ignore-src -r \
       --skip-keys="serial moteus_msgs" -y 2>/dev/null || true

# Install RoboSuite in editable mode
RUN ${RL_VENV}/bin/pip install --no-cache-dir -e ${ROVERFLAKE_ROOT}/src/external_pkgs/RoboSuite 2>/dev/null || true

# Install rl_autonomy (editable)
RUN ${RL_VENV}/bin/pip install --no-cache-dir -e ${ROVERFLAKE_ROOT} 2>/dev/null || true

# ============================================================================
# MuJoCo Rendering Configuration
# ============================================================================

# Default to GLFW (GUI). Override with MUJOCO_GL=egl for headless training.
ENV MUJOCO_GL=glfw

# For NVIDIA GPU support (uncomment if using GPU)
# ENV __GLX_VENDOR_LIBRARY_NAME=nvidia
# ENV NVIDIA_VISIBLE_DEVICES=all
# ENV NVIDIA_DRIVER_CAPABILITIES=all

# ============================================================================
# Entrypoint
# ============================================================================
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash"]
