{
  "name": "LearnFlake Dev",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "rover_rl",
  "workspaceFolder": "/LearnFlake",
  "runServices": [
    "rover_rl"
  ],
  "shutdownAction": "stopCompose",
  "remoteUser": "root",
  "containerEnv": {
    "DISPLAY": "host.docker.internal:0.0",
    "MUJOCO_GL": "glfw",
    "PREFER_LOCAL_X11": "0",
    "AUTO_CONFIGURE_DISPLAY": "1"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
